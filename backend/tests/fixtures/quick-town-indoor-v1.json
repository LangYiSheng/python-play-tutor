{
  "public": {"id": "quick-course-directions", "quest_id": null, "chapter_id": null, "content": {"schema_version": 1, "mode": "public", "title": "小镇日常", "entries": {"interaction:quick-course-signpost": [{"when": {"always": true}, "node": "signpost"}], "quick-course-reader": [{"when": {"always": true}, "node": "chat-lesson"}], "quick-course-coach": [{"when": {"always": true}, "node": "chat-practice"}], "quick-course-guide": [{"when": {"always": true}, "node": "chat-assessment"}]}, "bindings": {}, "nodes": [{"id": "signpost", "type": "dialogue", "text": "镇长大厅在镇子中央偏北，图书馆在西边，练习会馆在东南边。你想看看自己当前的目标吗？", "choices": [{"id": "journal", "label": "打开任务簿", "next": "journal"}, {"id": "leave", "label": "我知道了", "next": "end"}]}, {"id": "journal", "type": "action", "action": "open_workspace", "workspace": "journal", "next": "end"}, {"id": "chat-lesson", "type": "random", "next": ["chat-lesson-1", "chat-lesson-2", "chat-lesson-3"]}, {"id": "chat-lesson-1", "type": "dialogue", "text": "来馆里坐坐？这儿的书架一直摆着课程资料。想翻哪一份，走过去看看就好。", "next": "end"}, {"id": "chat-lesson-2", "type": "dialogue", "text": "你好，{name}。上次读过的资料还在书架上；要是只想随便翻翻，也很欢迎。", "next": "end"}, {"id": "chat-lesson-3", "type": "dialogue", "text": "今天想找什么资料？每个书架都能打开资料目录，你可以自己挑。", "next": "end"}, {"id": "chat-practice", "type": "random", "next": ["chat-practice-1", "chat-practice-2", "chat-practice-3"]}, {"id": "chat-practice-1", "type": "dialogue", "text": "来啦！两次练习之间也要歇一歇。下回带着新的章节练习再来，我们接着做。", "next": "end"}, {"id": "chat-practice-2", "type": "dialogue", "text": "今天过来走走？我做完练习会记下最想再试的一题，隔天再看常常会有新想法。", "next": "end"}, {"id": "chat-practice-3", "type": "dialogue", "text": "有空可以回图书馆翻翻资料。哪一页能帮你想通刚才的题，就记下它。", "next": "end"}, {"id": "chat-assessment", "type": "random", "next": ["chat-assessment-1", "chat-assessment-2", "chat-assessment-3"]}, {"id": "chat-assessment-1", "type": "dialogue", "text": "你好，{name}。今天想在镇上走走吗？西边有图书馆，练习会馆在东南边。", "next": "end"}, {"id": "chat-assessment-2", "type": "dialogue", "text": "图书馆的书架随时欢迎你。暂时没有章节任务的时候，也能回去看课程资料。", "next": "end"}, {"id": "chat-assessment-3", "type": "dialogue", "text": "不着急，按自己的步调来。想看看做过哪些事，可以翻翻任务簿。", "next": "end"}, {"id": "end", "type": "end"}]}},
  "entries": {"quick-course-reader": [{"when": {"all": [{"goal_ready": "lesson"}, {"activity_started": "lesson"}]}, "node": "resume-lesson"}, {"when": {"goal_ready": "lesson"}, "node": "ready-lesson"}, {"when": {"goal_ready": "meet-lesson"}, "node": "invite-lesson"}, {"when": {"always": true}, "node": "directions"}], "quick-course-coach": [{"when": {"all": [{"goal_ready": "practice"}, {"activity_started": "practice"}]}, "node": "resume-practice"}, {"when": {"goal_ready": "practice"}, "node": "ready-practice"}, {"when": {"goal_ready": "meet-practice"}, "node": "invite-practice"}, {"when": {"always": true}, "node": "directions"}], "quick-course-guide": [{"when": {"goal_ready": "welcome"}, "node": "welcome-mayor"}, {"when": {"goal_ready": "report"}, "node": "done-assessment"}, {"when": {"all": [{"goal_ready": "assessment"}, {"activity_started": "assessment"}]}, "node": "resume-assessment"}, {"when": {"goal_ready": "assessment"}, "node": "ready-assessment"}, {"when": {"goal_ready": "meet-assessment"}, "node": "invite-assessment"}, {"when": {"always": true}, "node": "directions"}]},
  "shared_nodes": [
    {"id": "library-location", "type": "dialogue", "text": "图书馆在镇子西边。走进馆里就能见到图书管理员。平时想重读资料，也可以直接去翻馆里的书架。", "next": "back-to-departure"},
    {"id": "mayor-goodbye", "type": "dialogue", "text": "回头见，{name}。等你练过了，回来跟我说说哪一部分花的时间最多。", "next": "end"},
    {"id": "ready-lesson", "type": "random", "next": ["ready-lesson-1", "ready-lesson-2"]},
    {"id": "ready-lesson-1", "type": "dialogue", "text": "你回来啦。《{chapter_name}》的资料还在这里，现在翻开吗？", "choices": [{"id": "start", "label": "开始阅读活动", "next": "start-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}]},
    {"id": "ready-lesson-2", "type": "dialogue", "text": "刚才说到这章的阅读。你要的资料已经备好了，坐下来读一会儿？", "choices": [{"id": "start", "label": "开始阅读活动", "next": "start-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}]},
    {"id": "resume-lesson", "type": "random", "next": ["resume-lesson-1", "resume-lesson-2"]},
    {"id": "resume-lesson-1", "type": "dialogue", "text": "欢迎回来，{name}。我们从上次读到的地方往下看吧。", "choices": [{"id": "start", "label": "继续阅读", "next": "open-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}]},
    {"id": "resume-lesson-2", "type": "dialogue", "text": "课件还在。要接着上次那一页读吗？", "choices": [{"id": "start", "label": "继续阅读", "next": "open-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}]},
    {"id": "start-lesson", "type": "dialogue", "text": "好，翻开资料吧。右侧的学习支持栏里可以查看本次阅读目标，哪里还想再读，你自己决定。", "next": "open-lesson"},
    {"id": "later-lesson", "type": "dialogue", "text": "好呀，随时来找我。我就在图书馆里。", "next": "end"},
    {"id": "paused-lesson", "type": "dialogue", "text": "好，先合上吧。下次回到这里，可以从上次的位置接着读。", "next": "end"},
    {"id": "open-lesson", "type": "activity", "binding": "lesson", "returns": {"completed": "done-lesson", "suspended": "paused-lesson", "unavailable": "unavailable"}},
    {"id": "ready-practice", "type": "random", "next": ["ready-practice-1", "ready-practice-2"]},
    {"id": "ready-practice-1", "type": "dialogue", "text": "练习还给你留着。现在要试第一题吗？", "choices": [{"id": "start", "label": "开始知识点练习", "next": "start-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}]},
    {"id": "ready-practice-2", "type": "dialogue", "text": "准备好了？我们把刚才读过的内容练一遍。", "choices": [{"id": "start", "label": "开始知识点练习", "next": "start-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}]},
    {"id": "resume-practice", "type": "random", "next": ["resume-practice-1", "resume-practice-2"]},
    {"id": "resume-practice-1", "type": "dialogue", "text": "回来了！我们从还没做完的题接着练。", "choices": [{"id": "start", "label": "继续练习", "next": "open-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}]},
    {"id": "resume-practice-2", "type": "dialogue", "text": "要继续上次的练习吗？先看一眼题单，就知道还有哪些要做。", "choices": [{"id": "start", "label": "继续练习", "next": "open-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}]},
    {"id": "start-practice", "type": "dialogue", "text": "来，先读第一题。可以慢慢试，做完了我们再聊。", "next": "open-practice"},
    {"id": "later-practice", "type": "dialogue", "text": "没问题。需要的话，先回图书馆看看资料；我在会馆等你。", "next": "end"},
    {"id": "paused-practice", "type": "dialogue", "text": "今天先练到这里也可以。下次来，接着自己的题单做就好。", "next": "end"},
    {"id": "open-practice", "type": "activity", "binding": "practice", "returns": {"completed": "done-practice", "suspended": "paused-practice", "unavailable": "unavailable"}},
    {"id": "ready-assessment", "type": "random", "next": ["ready-assessment-1", "ready-assessment-2"]},
    {"id": "ready-assessment-1", "type": "dialogue", "text": "想好了吗？要在这里开始本章的测验吗？", "choices": [{"id": "start", "label": "开始章节测验", "next": "start-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}]},
    {"id": "ready-assessment-2", "type": "dialogue", "text": "这份测验等你准备好了再开。现在开始吗？", "choices": [{"id": "start", "label": "开始章节测验", "next": "start-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}]},
    {"id": "resume-assessment", "type": "random", "next": ["resume-assessment-1", "resume-assessment-2"]},
    {"id": "resume-assessment-1", "type": "dialogue", "text": "要回到刚才那份测验吗？交卷前，把每道题都看一遍。", "choices": [{"id": "start", "label": "继续测验", "next": "open-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}]},
    {"id": "resume-assessment-2", "type": "dialogue", "text": "我们接着这份测验吧。交卷以后，再一起看看结果。", "choices": [{"id": "start", "label": "继续测验", "next": "open-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}]},
    {"id": "start-assessment", "type": "dialogue", "text": "好，接下来由你独立作答。完成后统一交卷，再回来找我。", "next": "open-assessment"},
    {"id": "later-assessment", "type": "dialogue", "text": "当然可以。想复习哪一页就去图书馆看一看，准备好再来。", "next": "end"},
    {"id": "paused-assessment", "type": "dialogue", "text": "我们先停一停。回到大厅后，你还能打开这份测验。", "next": "end"},
    {"id": "open-assessment", "type": "activity", "binding": "assessment", "returns": {"completed": "done-assessment", "suspended": "paused-assessment", "unavailable": "unavailable"}},
    {"id": "done-practice", "type": "dialogue", "text": "这一组练习你做完了。准备好了就回镇长大厅，找镇长领取《{chapter_name}》的测验。", "next": "end"},
    {"id": "done-assessment", "type": "dialogue", "text": "卷子已经收好了。我们看看这次的结果。", "next": "score"},
    {"id": "score", "type": "branch", "routes": [{"when": {"assessment_score": {"activity_id": "sample-assessment", "min": 100}}, "node": "score-all"}, {"when": {"always": true}, "node": "score-review"}]},
    {"id": "score-all", "type": "dialogue", "text": "这次每道题都答对了。你愿意的话，挑一道想一想，自己当时是怎么判断的？", "next": "report"},
    {"id": "score-review", "type": "dialogue", "text": "这次有些题还值得再看一眼。挑一道最拿不准的，回书架找找跟它有关的那一页就好。", "next": "report"},
    {"id": "directions", "type": "dialogue", "text": "看看左上角的任务目标，那里写着现在该做什么。", "next": "end"},
    {"id": "unavailable", "type": "dialogue", "text": "这项活动暂时打不开，请联系老师查看。", "next": "end"},
    {"id": "end", "type": "end"}
  ],
  "first_nodes": [
    {"id": "welcome-mayor", "type": "dialogue", "text": "欢迎来到学习小镇，{name}！我是镇长。接下来，我们会在这里陪你学习《{course_name}》。\n\n每章先去图书馆读资料，再到练习会馆找教练，把学到的知识用一用。准备好了就回来找我，我们做一次章节测验。", "next": "mayor-departure"},
    {"id": "mayor-departure", "type": "dialogue", "text": "第一站是镇西的图书馆。你也可以先到处走走，想继续时，看看屏幕左上角的任务目标。", "choices": [{"id": "where", "label": "图书管理员在哪里？", "next": "library-location"}, {"id": "leave", "label": "那我先去啦", "next": "mayor-goodbye"}], "checkpoint": "welcome"},
    {"id": "back-to-departure", "type": "dialogue", "text": "第一站是镇西的图书馆。你也可以先到处走走，想继续时，看看屏幕左上角的任务目标。", "choices": [{"id": "leave", "label": "那我先去啦", "next": "mayor-goodbye"}]},
    {"id": "invite-lesson", "type": "dialogue", "text": "你好呀，{name}，我是图书管理员。每章的学习资料都可以来这里找我。\n\n《{chapter_name}》的资料我已经备好了。我们现在一起翻开，还是过一会儿再读？", "choices": [{"id": "start", "label": "开始阅读活动", "next": "start-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}], "checkpoint": "meet-lesson"},
    {"id": "invite-practice", "type": "dialogue", "text": "你好，我是练习场教练！听馆员说，你读完了《{chapter_name}》。\n\n我替你备了一组练习。拿不准时先自己试一试，再看看题目的反馈。要试第一题吗？", "choices": [{"id": "start", "label": "开始知识点练习", "next": "start-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}], "checkpoint": "meet-practice"},
    {"id": "invite-assessment", "type": "dialogue", "text": "又见面了，{name}。本章的阅读和练习你都完成了。现在可以独立做《{chapter_name}》的测验，也可以先回去复习。", "choices": [{"id": "start", "label": "开始章节测验", "next": "start-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}], "checkpoint": "meet-assessment"},
    {"id": "done-lesson", "type": "dialogue", "text": "你把本章的资料都读完了。要不要试试自己找资料？看那边的书架，走过去互动，就能翻阅课程资料。\n\n有空再试也行。下一站是东南边的练习会馆，教练会陪你练一练。", "next": "end"},
    {"id": "report", "type": "dialogue", "text": "这一章学完了。想再学一章，来找我就行。现在先在镇上逛逛吧。", "choices": [{"id": "break", "label": "我先在镇上逛逛", "next": "end"}, {"id": "next", "label": "接下来可以做什么？", "next": "chapter-handoff"}], "checkpoint": "report"},
    {"id": "chapter-handoff", "type": "dialogue", "text": "想继续时，回到大厅找我开启下一章。馆里的书架也随时可以看。", "next": "end"}
  ],
  "first_order": ["welcome-mayor", "mayor-departure", "library-location", "back-to-departure", "mayor-goodbye", "invite-lesson", "ready-lesson", "ready-lesson-1", "ready-lesson-2", "resume-lesson", "resume-lesson-1", "resume-lesson-2", "start-lesson", "later-lesson", "paused-lesson", "open-lesson", "invite-practice", "ready-practice", "ready-practice-1", "ready-practice-2", "resume-practice", "resume-practice-1", "resume-practice-2", "start-practice", "later-practice", "paused-practice", "open-practice", "invite-assessment", "ready-assessment", "ready-assessment-1", "ready-assessment-2", "resume-assessment", "resume-assessment-1", "resume-assessment-2", "start-assessment", "later-assessment", "paused-assessment", "open-assessment", "done-lesson", "done-practice", "done-assessment", "score", "score-all", "score-review", "report", "chapter-handoff", "directions", "unavailable", "end"],
  "last_nodes": [
    {"id": "welcome-mayor", "type": "dialogue", "text": "{name}，又见面了。上次的测验已经交好了。今天想接着学《{chapter_name}》吗？", "choices": [{"id": "begin", "label": "开始这一章", "next": "mayor-departure"}, {"id": "later", "label": "我先歇一会儿", "next": "break-before-chapter"}]},
    {"id": "mayor-departure", "type": "dialogue", "text": "这章的资料已经放在图书馆了。你照自己的步调来，练完了再回这个大厅找我。", "choices": [{"id": "where", "label": "图书管理员在哪里？", "next": "library-location"}, {"id": "leave", "label": "那我先去啦", "next": "mayor-goodbye"}], "checkpoint": "welcome"},
    {"id": "back-to-departure", "type": "dialogue", "text": "这章的资料已经放在图书馆了。你照自己的步调来，练完了再回这个大厅找我。", "choices": [{"id": "leave", "label": "那我先去啦", "next": "mayor-goodbye"}]},
    {"id": "break-before-chapter", "type": "dialogue", "text": "好，你先逛逛。想开始新一章时，再来找我就行。", "next": "end"},
    {"id": "invite-lesson", "type": "dialogue", "text": "又见面啦，{name}。《{chapter_name}》这章的资料已经备好了。要打开读读吗？", "choices": [{"id": "start", "label": "开始阅读活动", "next": "start-lesson"}, {"id": "later", "label": "我先去逛逛", "next": "later-lesson"}], "checkpoint": "meet-lesson"},
    {"id": "invite-practice", "type": "dialogue", "text": "课件读完啦。这回轮到《{chapter_name}》的练习了，准备动手了吗？", "choices": [{"id": "start", "label": "开始知识点练习", "next": "start-practice"}, {"id": "later", "label": "稍后再来练", "next": "later-practice"}], "checkpoint": "meet-practice"},
    {"id": "invite-assessment", "type": "dialogue", "text": "《{chapter_name}》的练习完成了。还记得这里吧？独立完成这份测验，再来和我回顾。", "choices": [{"id": "start", "label": "开始章节测验", "next": "start-assessment"}, {"id": "later", "label": "我想先复习", "next": "later-assessment"}], "checkpoint": "meet-assessment"},
    {"id": "done-lesson", "type": "dialogue", "text": "这章读完了。想回顾资料可以随时翻书架；准备好动手时，去练习会馆找教练。", "next": "end"},
    {"id": "report", "type": "dialogue", "text": "这门课的章节都完成了，{name}。以后再想起哪一页，图书馆的书架随时都可以翻。", "choices": [{"id": "break", "label": "我先在镇上逛逛", "next": "end"}, {"id": "next", "label": "接下来可以做什么？", "next": "chapter-handoff"}], "checkpoint": "report"},
    {"id": "chapter-handoff", "type": "dialogue", "text": "想再读课程资料就到图书馆找书架。也欢迎你到会馆和教练聊聊。", "next": "end"}
  ],
  "last_order": ["welcome-mayor", "mayor-departure", "library-location", "back-to-departure", "mayor-goodbye", "break-before-chapter", "invite-lesson", "ready-lesson", "ready-lesson-1", "ready-lesson-2", "resume-lesson", "resume-lesson-1", "resume-lesson-2", "start-lesson", "later-lesson", "paused-lesson", "open-lesson", "invite-practice", "ready-practice", "ready-practice-1", "ready-practice-2", "resume-practice", "resume-practice-1", "resume-practice-2", "start-practice", "later-practice", "paused-practice", "open-practice", "invite-assessment", "ready-assessment", "ready-assessment-1", "ready-assessment-2", "resume-assessment", "resume-assessment-1", "resume-assessment-2", "start-assessment", "later-assessment", "paused-assessment", "open-assessment", "done-lesson", "done-practice", "done-assessment", "score", "score-all", "score-review", "report", "chapter-handoff", "directions", "unavailable", "end"]
}
